# ==============================================================================
# ConsensusX Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "mock", "gemini", "xai", "openai"
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=gemini-2.0-flash

# API Keys (Keep real keys in your local .env, NEVER commit .env to Git)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1

# LLM Generation Parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=30

# Cache & Storage
ENABLE_LLM_CACHE=true
CACHE_DIR=.cache/llm_responses

# Logging & Paths
LOG_LEVEL=INFO
FEVER_RAW_DATA_DIR=data/raw/fever
FEVER_PROCESSED_DATA_DIR=data/processed
OUTPUTS_DIR=outputs

# Experiment Defaults
DEFAULT_SAMPLE_SIZE=300
RANDOM_SEED=42

